# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Public HTTPS URL of this server (your ngrok / Cloudflare Tunnel URL), no trailing slash.
# Twilio signs requests against this exact URL, so it must match what you configured in Twilio.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Hosted services
DEEPGRAM_API_KEY=
TOGETHER_API_KEY=
CARTESIA_API_KEY=

# Model / voice choices (check each provider's current catalog before relying on these defaults)
STT_MODEL=nova-3-general
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
CARTESIA_VOICE_ID=

# Capacity (Phase 1 = one call at a time; Phase 6 replaces this with Redis admission control)
MAX_CONCURRENT_CALLS=1

# Local debugging only. Never set to true outside your laptop.
SKIP_TWILIO_SIGNATURE=false
